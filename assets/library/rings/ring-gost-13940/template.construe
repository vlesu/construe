    {"id": "v2", "name": "df", "expr": "18.2 mm", "comment": "Диаметр кольца в свободном состоянии"},
    {"id": "v3", "name": "s", "expr": "1.2 mm", "comment": "Толщина кольца"},
    {"id": "v4", "name": "b", "expr": "3.2 mm", "comment": "Ширина кольца"},
    {"id": "v5", "name": "d1", "expr": "18.6 mm", "comment": "Диаметр канавки"},
    {"id": "v6", "name": "w", "expr": "1.4 mm", "comment": "Ширина канавки m (имя m занято единицей «метр»)"},
    {"id": "v7", "name": "h", "expr": "2.1 mm", "comment": "Наименьшее расстояние от канавки до торца"}
