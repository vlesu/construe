  "variables": [
    {"id": "v1", "name": "d", "expr": "10 mm", "comment": "Номинальный диаметр резьбы"},
    {"id": "v2", "name": "l", "expr": "40 mm", "comment": "Длина шпильки (без ввинчиваемого конца)"},
