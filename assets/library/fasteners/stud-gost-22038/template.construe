    {"id": "v4", "name": "P", "expr": "1.5 mm", "comment": "Шаг резьбы (крупный)"},
    {"id": "v5", "name": "b", "expr": "min(l, 2 * d + 6 mm + 6 mm * min(1, max(0, ceil((l - 125 mm) / (1 mm)))) + 13 mm * min(1, max(0, ceil((l - 200 mm) / (1 mm)))))", "comment": "Длина резьбы гаечного конца b (ISO 888)"},
    {"id": "v6", "name": "pc", "type": "string", "expr": "58", "comment": "Класс прочности (для обозначения)"}
  ],
