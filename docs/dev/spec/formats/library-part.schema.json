{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construe.local/schema/library-part/1",
  "title": "construe library part description (library-part.json), formatVersion 1",
  "description": "Описание пакета элемента библиотеки стандартных деталей. Семантика полей, порядок проверок и коды ошибок — docs/dev/spec/library.md §2. Порядок свойств — порядок полей канонической записи (library.md §8). $defs/sizes — таблица типоразмеров в JSON (library.md §2.2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "id", "title", "section", "standards", "keyVariables", "designation"],
  "properties": {
    "format": { "const": "construe-library-part" },
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$", "maxLength": 128 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "section": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "standards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/standard" } },
    "equivalents": { "type": "array", "items": { "$ref": "#/$defs/standardRef" } },
    "icon": { "$ref": "#/$defs/path" },
    "template": { "$ref": "#/$defs/path" },
    "element": { "type": "string", "pattern": "^el(0|[1-9][0-9]{0,17})$" },
    "sizes": { "$ref": "#/$defs/path" },
    "keyVariables": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/variableName" } },
    "defaultSize": { "type": "string", "minLength": 1 },
    "designation": { "type": "string", "minLength": 1 },
    "isoAnalog": { "const": true, "description": "обозначения ISO столбца iso — аналоги (library.md §2.1, §2.2а); нет — тождественные" },
    "source": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "attachments": { "type": "array", "items": { "$ref": "#/$defs/attachment" }, "description": "именованные привязки (library.md §2.4, FX10-LIB-003)" },
    "cuts": { "type": "array", "items": { "$ref": "#/$defs/cut" }, "description": "вырезы элемента (library.md §2.5, FX10-LIB-009)" }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "description": "путь относительно папки пакета, разделитель /, без .. (library.md §2.3 п. 6)" },
    "variableName": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "standardRef": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2999 }
      }
    },
    "standard": {
      "type": "object", "additionalProperties": false, "required": ["code"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1900, "maximum": 2999 },
        "designation": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["standard"],
      "properties": {
        "standard": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind", "ref", "label"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "kind": { "enum": ["axis", "plane", "point"] },
        "ref": { "type": "string", "minLength": 1 },
        "flip": { "const": true },
        "label": { "type": "string", "minLength": 1 },
        "mate": { "enum": ["concentric", "coincident"] },
        "optional": { "const": true },
        "auto": { "enum": ["shoulder"] },
        "matchDiameter": { "const": true },
        "diameterKey": { "$ref": "#/$defs/variableName" }
      }
    },
    "expression": { "type": "string", "minLength": 1 },
    "range": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/expression" } },
    "cut": {
      "type": "object", "additionalProperties": false, "required": ["name", "title", "attachment"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "title": { "type": "string", "minLength": 1 },
        "attachment": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "revolve": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/range" } },
        "box": {
          "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
          "properties": { "x": { "$ref": "#/$defs/range" }, "y": { "$ref": "#/$defs/range" }, "z": { "$ref": "#/$defs/range" } }
        }
      }
    },
    "sizes": {
      "type": "object", "additionalProperties": false, "required": ["columns", "rows"],
      "properties": {
        "columns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "rows": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "values"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "values": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
