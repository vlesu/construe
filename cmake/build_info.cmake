# Build number and commit of the program (spec/update.md §2, REL-CT-002, FX14-PKG-001), its update system and package
# format (§2а, REL-CT-003). Run at every build in script mode:
#   cmake -DSOURCE_DIR=<repository> -DOUTPUT=<header> [-DBUILD_NUMBER=<n>] -DUPDATE_OS=<os> -DPACKAGE_FORMAT=<format>
#         -P build_info.cmake
# Writes CONSTRUE_BUILD_NUMBER (the committer time of HEAD in UTC as the integer YYYYMMDDhhmm; BUILD_NUMBER overrides it;
# 0 — unknown), CONSTRUE_BUILD_TAG (the build tag for file names: YYYYMMDD-hhmm for a date number, otherwise the number
# itself), CONSTRUE_COMMIT (short hash, empty without git), CONSTRUE_UPDATE_OS and CONSTRUE_PACKAGE_FORMAT (validated at
# configure time in src/CMakeLists.txt). The header is rewritten only when its content changes, so an unchanged commit
# causes no recompilation: the commit time, not the compile time, keeps the number reproducible.
# Print mode: cmake -DSOURCE_DIR=<repository> -DPRINT=ON -P build_info.cmake — prints the build number of HEAD to
# standard output (0 without git) and writes nothing; -DPRINT=TAG — the build tag instead.

set(_number "${BUILD_NUMBER}")
set(_commit "")
find_package(Git QUIET)
if(GIT_FOUND)
  if(_number STREQUAL "")
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" log -1 --format=%ct HEAD
                    OUTPUT_VARIABLE _epoch RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc EQUAL 0 AND _epoch MATCHES "^[0-9]+$")
      # string(TIMESTAMP) formats SOURCE_DATE_EPOCH instead of the current time: the commit time in UTC.
      set(_saved_epoch "$ENV{SOURCE_DATE_EPOCH}")
      set(ENV{SOURCE_DATE_EPOCH} "${_epoch}")
      string(TIMESTAMP _number "%Y%m%d%H%M" UTC)
      set(ENV{SOURCE_DATE_EPOCH} "${_saved_epoch}")
    endif()
  endif()
  if(NOT PRINT)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" rev-parse --short=7 HEAD
                    OUTPUT_VARIABLE _commit RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT _rc EQUAL 0 OR NOT _commit MATCHES "^[0-9a-f]+$")
      set(_commit "")
    endif()
  endif()
endif()
# 0 or an integer without leading zeros of at most 12 digits (CMake regular expressions have no {m,n}).
string(LENGTH "${_number}" _len)
if(NOT _number MATCHES "^(0|[1-9][0-9]*)$" OR _len GREATER 12)
  set(_number 0)
endif()

# The build tag (§2): a date number (12 digits, valid date and time fields) — YYYYMMDD-hhmm, otherwise the number.
set(_tag "${_number}")
if(_number MATCHES "^([2-9][0-9][0-9][0-9])(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])([01][0-9]|2[0-3])([0-5][0-9])$")
  set(_tag "${CMAKE_MATCH_1}${CMAKE_MATCH_2}${CMAKE_MATCH_3}-${CMAKE_MATCH_4}${CMAKE_MATCH_5}")
endif()

if(PRINT STREQUAL "TAG")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_tag}")
  return()
elseif(PRINT)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_number}")
  return()
endif()

set(_text "// Generated by cmake/build_info.cmake at build time (spec/update.md §2). Do not edit.
#pragma once
#define CONSTRUE_BUILD_NUMBER ${_number}LL
#define CONSTRUE_BUILD_TAG \"${_tag}\"
#define CONSTRUE_COMMIT \"${_commit}\"
#define CONSTRUE_UPDATE_OS \"${UPDATE_OS}\"
#define CONSTRUE_PACKAGE_FORMAT \"${PACKAGE_FORMAT}\"
")
set(_old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" _old)
endif()
if(NOT _old STREQUAL _text)
  file(WRITE "${OUTPUT}" "${_text}")
endif()
